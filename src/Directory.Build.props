<Project>
    <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EnablePackageValidation>true</EnablePackageValidation>
        <!-- pack fails on breaking public API changes against this published version; bump it after each release -->
        <PackageValidationBaselineVersion>2.0.1-beta</PackageValidationBaselineVersion>
        <Authors>starushykart</Authors>
        <Copyright>Copyright © 2024-2026 Artem Starushyk</Copyright>
        <Description>Application-side encryption of EF Core entity properties (AES-256-GCM) for any relational provider</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageProjectUrl>https://github.com/starushykart/ef-core-encryption</PackageProjectUrl>
        <PackageTags>efcore;entity-framework-core;encryption;aes-gcm;kms</PackageTags>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <!-- documenting only the parameters that need it -->
        <NoWarn>$(NoWarn);CS1573</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

</Project>
